+/**
+ * fpi_print_sigfm_match:
+ * @template: A #FpPrint containing one or more prints
+ * @print: A newly scanned #FpPrint to test
+ * @bz3_threshold: The BZ3 match threshold
+ * @error: Return location for error
+ *
+ * Match the newly scanned @print (containing exactly one print) against the
+ * prints contained in @template which will have been stored during enrollment.
+ *
+ * Both @template and @print need to be of type #FPI_PRINT_SIGFM for this to
+ * work.
+ *
+ * Returns: Whether the prints match, @error will be set if #FPI_MATCH_ERROR is returned
+ */
+FpiMatchResult
+fpi_print_sigfm_match (FpPrint *print_template,
+                       FpPrint *print,
+                       gint     threshold,
+                       GError **error)
+{
+  SigfmImgInfo *probe;
+
+  if (print->type != FPI_PRINT_SIGFM)
+    {
+      *error = fpi_device_error_new_msg (FP_DEVICE_ERROR_NOT_SUPPORTED,
+                                         "It is only possible to match SIGFM type print data");
+      return FPI_MATCH_ERROR;
+    }
+
+  /* A stored print made with another matcher (e.g. an NBIS print from a
+   * swipe-mode build) simply cannot match; skip it rather than failing the
+   * whole identify for every other enrolled finger. */
+  if (print_template->type != FPI_PRINT_SIGFM)
+    {
+      fp_dbg ("skipping non-SIGFM template (type %d)", print_template->type);
+      return FPI_MATCH_FAIL;
+    }
+
+  if (print->prints->len != 1)
+    {
+      *error = fpi_device_error_new_msg (FP_DEVICE_ERROR_GENERAL,
+                                         "New print contains more than one print!");
+      return FPI_MATCH_ERROR;
+    }
+
+  probe = g_ptr_array_index (print->prints, 0);
+
+  for (guint i = 0; i < print_template->prints->len; i++)
+    {
+      SigfmImgInfo *enrolled = g_ptr_array_index (print_template->prints, i);
+      gint score = sigfm_match_score (enrolled, probe);
+
+      if (score < 0)
+        {
+          *error = fpi_device_error_new_msg (FP_DEVICE_ERROR_DATA_INVALID,
+                                             "error in sigfm_match_score");
+          return FPI_MATCH_ERROR;
+        }
+      fp_dbg ("sigfm score %d/%d", score, threshold);
+
+      if (score >= threshold)
+        return FPI_MATCH_SUCCESS;
+    }
+
+  return FPI_MATCH_FAIL;
+}
