+/* SIGFM (SIFT keypoints + descriptors), an alternative to NBIS minutiae for
+ * small-area sensors. Kept separate from the NBIS task: its own source tag,
+ * worker and finish function. */
+typedef struct
+{
+  guchar       *image;
+  gint          width;
+  gint          height;
+  SigfmImgInfo *sigfm_info;
+} ExtractSigfmData;
+
+static void
+fp_image_sigfm_extract_free (ExtractSigfmData *data)
+{
+  g_clear_pointer (&data->image, g_free);
+  g_clear_pointer (&data->sigfm_info, sigfm_free_info);
+  g_free (data);
+}
+
+#define SIGFM_MIN_KEYPOINTS 25
+
+static void
+fp_image_sigfm_extract_thread_func (GTask        *task,
+                                    gpointer      source_object,
+                                    gpointer      task_data,
+                                    GCancellable *cancellable)
+{
+  g_autoptr(GTask) thread_task = g_steal_pointer (&task);
+  g_autoptr(GTimer) timer = g_timer_new ();
+  ExtractSigfmData *data = task_data;
+  gint keypoints;
+
+  data->sigfm_info = sigfm_extract (data->image, data->width, data->height);
+  keypoints = data->sigfm_info ? sigfm_keypoints_count (data->sigfm_info) : 0;
+  fp_dbg ("sigfm extract completed in %f secs, %dx%d image, %d keypoints",
+          g_timer_elapsed (timer, NULL), data->width, data->height, keypoints);
+
+  if (keypoints < SIGFM_MIN_KEYPOINTS)
+    {
+      g_task_return_new_error (thread_task, G_IO_ERROR, G_IO_ERROR_FAILED,
+                               "Not enough keypoints found (%d)", keypoints);
+      return;
+    }
+
+  g_task_return_boolean (thread_task, TRUE);
+}
+
+/**
+ * fp_image_get_sigfm_info:
+ * @self: A #FpImage
+ *
+ * Gets the SIGFM keypoints and descriptors for an image. This data must
+ * not be modified or freed. Extract them first using
+ * fp_image_extract_sigfm_info().
+ *
+ * Returns: (transfer none) (nullable): The SIGFM data, or %NULL
+ */
+SigfmImgInfo *
+fp_image_get_sigfm_info (FpImage *self)
+{
+  g_return_val_if_fail (FP_IS_IMAGE (self), NULL);
+
+  return self->sigfm_info;
+}
+
+/**
+ * fp_image_extract_sigfm_info:
+ * @self: A #FpImage
+ * @cancellable: a #GCancellable, or %NULL
+ * @callback: the function to call on completion
+ * @user_data: the data to pass to @callback
+ *
+ * Extracts SIGFM keypoints and descriptors from an image. Finish with
+ * fp_image_extract_sigfm_info_finish().
+ */
+void
+fp_image_extract_sigfm_info (FpImage            *self,
+                             GCancellable       *cancellable,
+                             GAsyncReadyCallback callback,
+                             gpointer            user_data)
+{
+  g_autoptr(GTask) task = NULL;
+  ExtractSigfmData *data;
+
+  g_return_if_fail (FP_IS_IMAGE (self));
+  g_return_if_fail (callback != NULL);
+
+  task = g_task_new (self, cancellable, callback, user_data);
+  g_task_set_source_tag (task, fp_image_extract_sigfm_info);
+  g_task_set_check_cancellable (task, TRUE);
+
+  data = g_new0 (ExtractSigfmData, 1);
+  data->image = g_memdup2 (self->data, self->width * self->height);
+  data->width = self->width;
+  data->height = self->height;
+  g_task_set_task_data (task, data, (GDestroyNotify) fp_image_sigfm_extract_free);
+
+  g_task_run_in_thread (g_steal_pointer (&task), fp_image_sigfm_extract_thread_func);
+}
+
+/**
+ * fp_image_extract_sigfm_info_finish:
+ * @self: A #FpImage
+ * @result: A #GAsyncResult
+ * @error: Return location for errors, or %NULL to ignore
+ *
+ * Finish SIGFM extraction; on success the data is available through
+ * fp_image_get_sigfm_info().
+ *
+ * Returns: %TRUE on success
+ */
+gboolean
+fp_image_extract_sigfm_info_finish (FpImage      *self,
+                                    GAsyncResult *result,
+                                    GError      **error)
+{
+  ExtractSigfmData *data;
+
+  g_return_val_if_fail (FP_IS_IMAGE (self), FALSE);
+  g_return_val_if_fail (g_task_is_valid (result, self), FALSE);
+  g_return_val_if_fail (g_task_get_source_tag (G_TASK (result)) ==
+                        fp_image_extract_sigfm_info, FALSE);
+
+  /* Normalize the image data like NBIS detection does, so API users (e.g.
+   * fp_device_capture) get the same orientation and polarity. SIGFM itself
+   * ran on the unnormalized copy, which is what the stored prints are based
+   * on. */
+  if (self->flags & FPI_IMAGE_H_FLIPPED)
+    hflip (self->data, self->width, self->height);
+  if (self->flags & FPI_IMAGE_V_FLIPPED)
+    vflip (self->data, self->width, self->height);
+  if (self->flags & FPI_IMAGE_COLORS_INVERTED)
+    invert_colors (self->data, self->width, self->height);
+  self->flags &= ~(FPI_IMAGE_H_FLIPPED | FPI_IMAGE_V_FLIPPED | FPI_IMAGE_COLORS_INVERTED);
+
+  if (!g_task_propagate_boolean (G_TASK (result), error))
+    return FALSE;
+
+  data = g_task_get_task_data (G_TASK (result));
+  g_clear_pointer (&self->sigfm_info, sigfm_free_info);
+  self->sigfm_info = g_steal_pointer (&data->sigfm_info);
+
+  return TRUE;
+}
