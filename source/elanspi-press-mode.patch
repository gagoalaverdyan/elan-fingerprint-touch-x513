+/*
+ * Press (place-and-hold) capture for square area sensors.
+ *
+ * The swipe path discards frames that do not differ from the previous one, so
+ * a stationary finger never yields enough frames and every touch is reported
+ * as a short swipe. Here, once the finger is down, a few frames that fully
+ * cover the sensor are collected; the sharpest one (highest variance) is
+ * chosen, averaged with any other frames that are near-identical to it (the
+ * finger did not move, so this only reduces sensor noise), and submitted as a
+ * single full-size image.
+ */
+/* Debug aid for offline tuning: when ELANSPI_DUMP_FILE is set in the
+ * environment of the process using libfprint (never set for fprintd), write
+ * the collected press frames there. Format: "ELP1", u16 width, u16 height,
+ * u16 count, u16 best, count * i64 quality, count * width*height u16
+ * background-corrected frames in sensor (unrotated) layout. */
+static void
+elanspi_press_dump (FpiDeviceElanSpi *self, guint best)
+{
+  const gchar *path = g_getenv ("ELANSPI_DUMP_FILE");
+  gsize npix = (gsize) self->sensor_width * self->sensor_height;
+  guint16 hdr[4] = { self->sensor_width, self->sensor_height, self->press_count, best };
+  FILE *f;
+
+  if (!path || !*path)
+    return;
+  f = fopen (path, "wb");
+  if (!f)
+    {
+      fp_warn ("<press> cannot write dump %s", path);
+      return;
+    }
+  fwrite ("ELP1", 1, 4, f);
+  fwrite (hdr, sizeof (guint16), 4, f);
+  fwrite (self->press_quality, sizeof (gint64), self->press_count, f);
+  fwrite (self->press_frames, sizeof (guint16), npix * self->press_count, f);
+  fclose (f);
+  fp_dbg ("<press> dumped %u frames to %s", self->press_count, path);
+}
+
+static void
+elanspi_press_submit (FpiDeviceElanSpi *self)
+{
+  g_autoptr(FpImage) img = NULL;
+  gsize npix = (gsize) self->sensor_width * self->sensor_height;
+  g_autofree guint32 *acc = g_malloc0_n (npix, sizeof (guint32));
+  g_autofree guint16 *avg = g_malloc_n (npix, sizeof (guint16));
+  guint16 *best_frame;
+  guint best = 0, used = 0;
+
+  g_assert (self->press_count > 0);
+
+  for (guint i = 1; i < self->press_count; i += 1)
+    if (self->press_quality[i] > self->press_quality[best])
+      best = i;
+  best_frame = self->press_frames + best * npix;
+  elanspi_press_dump (self, best);
+
+  for (guint i = 0; i < self->press_count; i += 1)
+    {
+      guint16 *frame = self->press_frames + i * npix;
+
+      if (i != best)
+        {
+          gint64 diff = elanspi_get_frame_diff_stddev_sq (self, best_frame, frame);
+          if (diff >= ELANSPI_PRESS_MAX_AVERAGE_DIFF)
+            {
+              fp_dbg ("<press> frame %u moved (diff %" G_GINT64_FORMAT "), not averaged", i, diff);
+              continue;
+            }
+        }
+      for (gsize p = 0; p < npix; p += 1)
+        acc[p] += frame[p];
+      used += 1;
+    }
+
+  for (gsize p = 0; p < npix; p += 1)
+    avg[p] = acc[p] / used;
+
+  fp_dbg ("<press> submitting %ux%u image: best frame %u (stddev %" G_GINT64_FORMAT "), %u/%u frames averaged",
+          self->frame_width, self->frame_height, best, self->press_quality[best], used, self->press_count);
+
+  img = fp_image_new (self->frame_width, self->frame_height);
+  elanspi_process_frame (self, avg, img->data);
+  /* No smoothing here, unlike the stitched swipe image: frame averaging
+   * already suppresses sensor noise, and on 40 recorded press captures
+   * smoothing cut SIGFM keypoints from ~99 to ~60 and raised genuine
+   * rejections (10-image template, threshold 100) from 0.4% to 3.2%, while
+   * impostor scores stayed <= 8. */
+  img->flags |= FPI_IMAGE_COLORS_INVERTED;
+
+  fpi_image_device_image_captured (FP_IMAGE_DEVICE (self), g_steal_pointer (&img));
+}
+
+static void
+elanspi_press_frame_handler (FpiSsm *ssm, FpiDeviceElanSpi *self)
+{
+  enum elanspi_guess_result guess = elanspi_guess_image (self, self->last_image);
+  gsize npix = (gsize) self->sensor_width * self->sensor_height;
+
+  if (guess == ELANSPI_GUESS_EMPTY)
+    {
+      self->fp_empty_counter += 1;
+      if (self->fp_empty_counter < ELANSPI_MIN_FRAMES_DEBOUNCE)
+        goto next_frame;
+
+      if (self->press_count >= ELANSPI_PRESS_MIN_FRAMES)
+        {
+          fp_dbg ("<press> finger lifted, using %u frames", self->press_count);
+          elanspi_press_submit (self);
+        }
+      else
+        {
+          fp_dbg ("<press> finger lifted before a stable frame (%u)", self->press_count);
+          fpi_image_device_retry_scan (FP_IMAGE_DEVICE (self), FP_DEVICE_RETRY_REMOVE_FINGER);
+        }
+      goto finish_capture;
+    }
+
+  self->fp_empty_counter = 0;
+
+  if (guess == ELANSPI_GUESS_FINGERPRINT &&
+      self->last_guess_invalid_percent <= ELANSPI_PRESS_MAX_INVALID_PERCENT)
+    {
+      guint16 *slot = self->press_frames + self->press_count * npix;
+
+      memcpy (slot, self->last_image, npix * sizeof (guint16));
+      elanspi_correct_with_bg (self, slot);
+      self->press_quality[self->press_count] = self->last_guess_sq_stddev;
+      self->press_count += 1;
+
+      if (self->press_count == ELANSPI_PRESS_SAMPLE_FRAMES)
+        {
+          elanspi_press_submit (self);
+          goto finish_capture;
+        }
+    }
+  else
+    {
+      /* partial contact while the finger settles, or an ambiguous frame */
+      self->press_settle += 1;
+      if (self->press_settle > ELANSPI_PRESS_MAX_SETTLE_FRAMES)
+        {
+          if (self->press_count >= ELANSPI_PRESS_MIN_FRAMES)
+            {
+              elanspi_press_submit (self);
+            }
+          else
+            {
+              fp_dbg ("<press> finger never covered the sensor");
+              fpi_image_device_retry_scan (FP_IMAGE_DEVICE (self), FP_DEVICE_RETRY_CENTER_FINGER);
+            }
+          goto finish_capture;
+        }
+    }
+
+next_frame:
+  fpi_ssm_jump_to_state_delayed (ssm, ELANSPI_FPCAPT_FP_CAPTURE, ELANSPI_HV_SENSOR_FRAME_DELAY);
+  return;
+
+finish_capture:
+  self->press_count = 0;
+  self->press_settle = 0;
+  self->finger_wait_debounce = 0;
+  fpi_ssm_jump_to_state (ssm, ELANSPI_FPCAPT_WAITUP_CAPTURE);
+}
