+/*
+ * Press mode: decide whether the freshly calibrated background (in
+ * last_image) was taken on an empty sensor. A finger during calibration makes
+ * the gain search fail to converge; if it did converge, compare against the
+ * last background known to be empty, which is only meaningful at equal gain.
+ */
+static gboolean
+elanspi_press_bg_is_empty (FpiDeviceElanSpi *self)
+{
+  enum elanspi_guess_result guess;
+  guint16 *saved_bg;
+
+  if (!self->calib_converged)
+    return FALSE;
+  if (!self->good_bg || self->calib_gdac != self->good_gdac)
+    return TRUE;
+
+  saved_bg = self->bg_image;
+  self->bg_image = self->good_bg;
+  guess = elanspi_guess_image (self, self->last_image);
+  self->bg_image = saved_bg;
+
+  return guess == ELANSPI_GUESS_EMPTY;
 }
 
